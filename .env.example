# Copy to .env and change the password. .env is git-ignored.
# SQL Server requires 8+ characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# GeoServer (only with `docker compose --profile gis up -d`)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=ChangeMe_Ge0server!
# GeoServer reads the database with its own read-only login, created by geoserver/setup.sh
GEOSERVER_DB_PASSWORD=ChangeMe_Read0nly!
