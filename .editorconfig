root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

[*.{csproj,props,targets,slnx}]
indent_size = 2

# Test method names read like sentences: Method_does_something_when_condition
[backend/tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# xUnit test classes are instantiated by the framework
dotnet_diagnostic.CA1515.severity = none

# EF Core migrations are generated by `dotnet ef`
[backend/src/KulturRotasi.Infrastructure/Persistence/Migrations/**.cs]
generated_code = true
